<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /

    # 1. FORCE HTTPS
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # 2. CONTROL DOMAIN / WWW REDIRECT (Redirect www.saimaprojects.com to saimaprojects.com)
    RewriteCond %{HTTP_HOST} ^www\.saimaprojects\.com$ [NC]
    RewriteRule ^(.*)$ https://saimaprojects.com/$1 [R=301,L]

    # 3. HANDLE AUTHORIZATION HEADER
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 4. REDIRECT TRAILING SLASHES IF NOT A FOLDER
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 5. SEND ALL REQUESTS TO LARAVEL FRONT CONTROLLER (index.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# 6. GSC SUBDOMAIN INDEXING SHIELD (NOINDEX HEADER)
<IfModule mod_headers.c>
    SetEnvIfNoCase Host "^(mail|admin|webmail|cpanel|webdisk|autodiscover|cpcontacts|cpcalendars)\." NOINDEX_SUBDOMAIN
    Header set X-Robots-Tag "noindex, nofollow, noarchive" env=NOINDEX_SUBDOMAIN
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. FORCE HTTPS
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 2. CONTROL ALL SUBDOMAINS (mail, admin, webmail, cpanel, www, etc.)
  RewriteCond %{HTTP_HOST} !^hudayriyat-island\.ae$ [NC]
  RewriteRule ^(.*)$ https://hudayriyat-island.ae/$1 [R=301,L]

  # 3. ROOT URL (/) PROXY DIRECTLY TO NEXT.JS
  RewriteRule ^$ http://d13021.fra1.stableserver.net:4000/ [P,L]

  # 4. PREVENT DIRECTORYINDEX (index.html / index.php) FROM BREAKING NEXT.JS
  RewriteRule ^index\.(html?|php)$ http://d13021.fra1.stableserver.net:4000/ [P,L]

  # 5. PROXY ALL OTHER PAGES TO NEXT.JS
  RewriteRule ^(.*)$ http://d13021.fra1.stableserver.net:4000/$1 [P,L]
</IfModule>

# 6. GSC SUBDOMAIN INDEXING SHIELD (NOINDEX HEADER)
<IfModule mod_headers.c>
  SetEnvIfNoCase Host "^(mail|admin|webmail|cpanel|webdisk|autodiscover|cpcontacts|cpcalendars)\." NOINDEX_SUBDOMAIN
  Header set X-Robots-Tag "noindex, nofollow, noarchive" env=NOINDEX_SUBDOMAIN
</IfModule>
